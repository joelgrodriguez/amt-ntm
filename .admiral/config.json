{
  "name": "standard-press",
  "taxonomy": {
    "client": "standard",
    "project": "standard-press"
  },
  "baseBranch": "dev",
  "taskPrefix": "Admiral",
  "setupCommand": "npm ci --prefer-offline --no-audit --no-fund",
  "tasks": {
    "backend": "github-issues"
  },
  "statuses": {
    "inProgress": "in-progress",
    "inReview": "in-review"
  },
  "workflow": {
    "landing": "local"
  },
  "labels": {
    "required": [
      "admiral",
      "client:<client>",
      "project:<project>",
      "type:<work-type>",
      "area:<area>",
      "agent:<agent>",
      "risk:<low|medium|high>"
    ]
  },
  "policy": {
    "forbiddenPaths": [
      ".env",
      ".env.*"
    ]
  },
  "router": {
    "typeDefaults": {
      "feature": "implementer",
      "bugfix": "implementer",
      "refactor": "implementer",
      "backend": "implementer",
      "ui": "implementer",
      "chore": "implementer",
      "docs": "docs",
      "copy": "marketer",
      "research": "scout",
      "test": "verifier"
    },
    "seats": {
      "orchestrator": {
        "command": "claude --model fable --effort high --dangerously-skip-permissions",
        "fallback": [
          "codex -m gpt-5.6-sol -c model_reasoning_effort=xhigh --dangerously-bypass-approvals-and-sandbox",
          "opencode run -m zhipuai-coding-plan/glm-5.2 \"<prompt>\""
        ],
        "timeout": "15m"
      },
      "scout": {
        "command": "grok -m grok-4.5",
        "fallback": [
          "codex -m gpt-5.6-sol -c model_reasoning_effort=medium --dangerously-bypass-approvals-and-sandbox",
          "agy --model \"Gemini 3.1 Pro (High)\" --mode plan --print \"<prompt>\" --print-timeout 10m"
        ],
        "timeout": "8m"
      },
      "implementer": {
        "command": "codex -m gpt-5.6-sol -c model_reasoning_effort=medium --dangerously-bypass-approvals-and-sandbox",
        "fallback": [
          "agy --model \"Gemini 3.5 Flash (High)\" --mode plan --print \"<prompt>\" --print-timeout 10m"
        ],
        "timeout": "30m"
      },
      "verifier": {
        "command": "opencode run -m zhipuai-coding-plan/glm-5.2 \"<prompt>\"",
        "fallback": [
          "codex -m gpt-5.6-sol -c model_reasoning_effort=medium --dangerously-bypass-approvals-and-sandbox",
          "agy --model \"Gemini 3.5 Flash (High)\" --mode plan --print \"<prompt>\" --print-timeout 10m"
        ],
        "timeout": "10m"
      },
      "reviewer": {
        "command": "claude --model fable --effort high --dangerously-skip-permissions",
        "fallback": [
          "grok -m grok-4.5",
          "opencode run -m zhipuai-coding-plan/glm-5.2 \"<prompt>\""
        ],
        "timeout": "5m"
      },
      "marketer": {
        "command": "grok -m grok-4.5",
        "fallback": [
          "claude --model claude-opus-4-8 --effort xhigh --dangerously-skip-permissions",
          "agy --model \"Gemini 3.1 Pro (High)\" --mode plan --print \"<prompt>\" --print-timeout 10m"
        ],
        "timeout": "8m"
      },
      "docs": {
        "command": "claude --agent docs-writer --model claude-opus-4-8 --effort xhigh --dangerously-skip-permissions",
        "fallback": [
          "grok -m grok-4.5",
          "agy --model \"Gemini 3.1 Pro (High)\" --mode plan --print \"<prompt>\" --print-timeout 10m"
        ],
        "timeout": "15m"
      }
    }
  },
  "reviewLanes": {
    "baseline": [
      "cross-vendor"
    ],
    "riskLabelOrder": [
      "security",
      "data-integrity",
      "concurrency",
      "accessibility",
      "performance"
    ],
    "riskLabels": {
      "security": [
        "security"
      ],
      "data-integrity": [
        "data-integrity"
      ],
      "concurrency": [
        "concurrency"
      ],
      "accessibility": [
        "accessibility"
      ],
      "performance": [
        "performance"
      ]
    }
  },
  "validationCommand": "npm run build",
  "coordinationState": {
    "gitCommonDir": "admiral",
    "fallbackDir": ".admiral"
  },
  "localState": [
    ".admiral/events.jsonl",
    ".admiral/active.md",
    ".admiral/archive.md"
  ]
}
